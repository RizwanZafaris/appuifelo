<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config for Felo.
  - Disallows cleartext traffic everywhere except localhost / emulator (dev).
  - Pins the production API to a small set of certificate authorities.
  - Cert-pinning at the SPKI hash level lives in lib/core/network/dio_provider.dart
    (HttpClient.badCertificateCallback + manual SPKI compare). This file is the
    OS-level gate.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Localhost / emulator-only cleartext for `flutter run` against a dev
         backend. Stripped from release manifests via flavors. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
