<?xml version="1.0" encoding="utf-8"?>
<!--
  Disable cloud / device-transfer backup of app data.
  Felo holds tokens in flutter_secure_storage (Android Keystore-backed) and
  PII in Drift (SQLite). None of it should be silently restored to a new
  device — the user must re-authenticate and re-sync from the backend.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
